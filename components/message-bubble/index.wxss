/* components/message-bubble/index.wxss */
.message-bubble {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

/* 用户消息 - 右对齐 */
.message-bubble.user {
  flex-direction: row-reverse;
}

/* AI 消息 - 左对齐 */
.message-bubble.assistant {
  flex-direction: row;
}

/* 头像 */
.avatar-wrapper {
  flex-shrink: 0;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

/* 气泡内容 */
.bubble-content {
  max-width: calc(100% - 120rpx);
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  word-wrap: break-word;
  word-break: break-all;
}

/* 用户消息样式 */
.message-bubble.user .bubble-content {
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

/* AI 消息样式 */
.message-bubble.assistant .bubble-content {
  background-color: #ffffff;
  color: #333333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 文本内容 */
.text-content {
  font-size: 28rpx;
  line-height: 1.7;
}

/* ========== 思考中 loading 动效 ========== */
.thinking-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 8rpx;
  min-height: 48rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #94a3b8;
  animation: dotPulse 1.4s ease-in-out infinite both;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.3;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 时间戳 */
.timestamp {
  display: flex;
  align-items: flex-end;
  flex-shrink: 0;
}

.time-text {
  font-size: 22rpx;
  color: #999;
}
