/* components/typing-text/index.wxss */
.typing-text {
  display: inline;
  word-wrap: break-word;
  word-break: break-word;
  overflow-wrap: break-word;
}

.text-content {
  line-height: 1.75;
  word-break: break-word;
  overflow-wrap: break-word;
}

.cursor {
  display: inline;
  color: #1890ff;
  font-weight: 300;
  opacity: 0;
  transition: opacity 0.1s;
}

.cursor.visible {
  opacity: 1;
}
