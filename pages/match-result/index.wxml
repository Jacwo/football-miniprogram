<!-- pages/match-result/index.wxml - 赛果列表 -->
<view class="result-page">
  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-wrapper" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 主内容 -->
  <view class="main-content" wx:else>
    <!-- 页面标题 -->
    <view class="page-header">
      <text class="page-title" wx:if="{{activeTab === 'live'}}">📺 实时</text>
      <text class="page-title" wx:elif="{{activeTab === 'result'}}">⚽ 赛果</text>
      <text class="page-title" wx:else>📝 历史</text>
      <text class="page-desc" wx:if="{{activeTab === 'live'}}">查看比赛实时进展</text>
      <text class="page-desc" wx:elif="{{activeTab === 'result'}}">查看比赛开奖结果</text>
      <text class="page-desc" wx:else>查看历史分析记录</text>
    </view>

    <!-- Tab 切换 -->
    <view class="tabs">
      <view
        class="tab-item {{activeTab === 'live' ? 'active' : ''}}"
        data-tab="live"
        bindtap="onTabChange"
      >
        <text class="tab-text">实时</text>
      </view>
      <view
        class="tab-item {{activeTab === 'result' ? 'active' : ''}}"
        data-tab="result"
        bindtap="onTabChange"
      >
        <text class="tab-text">赛果</text>
      </view>
      <view
        class="tab-item {{activeTab === 'history' ? 'active' : ''}} {{!showHistory ? 'hidden' : ''}}"
        data-tab="history"
        bindtap="onTabChange"
        wx:if="{{showHistory}}"
      >
        <text class="tab-text">历史</text>
      </view>
    </view>

    <!-- 比分直播列表 -->
    <block wx:if="{{activeTab === 'live'}}">
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{liveMatches.length === 0}}">
        <text class="empty-icon">📺</text>
        <text class="empty-text">暂无直播</text>
        <text class="empty-tip">当前没有比赛直播</text>
      </view>

      <!-- 直播列表 -->
      <view class="content-wrapper" wx:else>
        <view class="refresh-btn" bindtap="onRefresh">
          <text class="refresh-icon">🔄</text>
        </view>
        <scroll-view class="results-scroll" scroll-y>
        <view class="live-item" wx:for="{{liveMatches}}" wx:key="matchId">
          <!-- 比赛头部 -->
          <view class="live-header">
            <view class="live-league">
              <text class="league-tag" style="background-color: #{{item.displayColor}}">{{item.leagueAbbName}}</text>
              <text class="live-status">{{item.matchPhaseTcName || item.matchStatusName}}</text>
            </view>
            <view class="live-time">
              <text class="live-date">{{item.displayDate}}</text>
              <text class="live-clock" wx:if="{{item.matchStatus !== 0}}">{{item.displayTime}}</text>
              <text class="live-clock upcoming" wx:else>未开赛</text>
            </view>
          </view>

          <!-- 比分区域 -->
          <view class="live-score-section">
            <view class="live-team home">
              <text class="live-team-name">{{item.homeTeamAbbName}}</text>
            </view>
            <view class="live-score-box">
              <text class="live-score upcoming" wx:if="{{item.matchStatus === 0}}">未开赛</text>
              <text class="live-score" wx:else>{{item.sectionsNo999 || '-'}}</text>
              <text class="live-half-score" wx:if="{{item.sectionsNo1}}">半场 {{item.sectionsNo1}}</text>
              <text class="live-minute" wx:if="{{item.matchMinute && item.matchMinute !== '0' && item.matchMinute !== 0}}">{{item.matchMinute}}'</text>
              <text class="live-minute upcoming" wx:if="{{!item.matchMinute || item.matchMinute === '0' || item.matchMinute === 0}}">未开赛</text>
            </view>
            <view class="live-team away">
              <text class="live-team-name">{{item.awayTeamAbbName}}</text>
            </view>
          </view>

          <!-- 事件时间线 -->
          <view class="live-events" wx:if="{{item.events.length > 0}}">
            <view class="events-title">比赛事件</view>
            <view class="timeline-wrap">
              <view class="timeline-line"></view>
              <block wx:for="{{item.events}}" wx:for-item="event" wx:key="index">
                <!-- 中场分隔线 -->
                <view class="half-separator" wx:if="{{event._showHalfLine}}">
                  <view class="half-separator-line"></view>
                </view>
                <view class="event-item {{event.isHome ? 'home' : 'away'}}">
                  <!-- 主队：球员信息 + 图标时间 都在线左侧 -->
                  <block wx:if="{{event.isHome}}">
                    <view class="event-side home">
                      <view class="event-info">
                        <text class="event-player">{{event.personEnName}}</text>
                      </view>
                      <view class="event-mark">
                        <text class="event-icon {{event.eventCode === 'PG' ? 'penalty' : ''}}" wx:if="{{event.eventCode === 'G' || event.eventCode === 'PG'}}">⚽</text>
                        <text class="event-icon" wx:elif="{{event.eventCode === 'OG'}}">🔴</text>
                        <text class="event-icon" wx:elif="{{event.eventCode === 'Y'}}">🟨</text>
                        <text class="event-icon" wx:elif="{{event.eventCode === 'R'}}">🟥</text>
                        <text class="event-icon dot" wx:else>●</text>
                        <text class="event-time">{{event._displayMinute}}'</text>
                      </view>
                    </view>
                    <view class="event-side placeholder"></view>
                  </block>
                  <!-- 客队：图标时间 + 球员信息 都在线右侧 -->
                  <block wx:else>
                    <view class="event-side placeholder"></view>
                    <view class="event-side away">
                      <view class="event-mark">
                        <text class="event-time">{{event._displayMinute}}'</text>
                        <text class="event-icon {{event.eventCode === 'PG' ? 'penalty' : ''}}" wx:if="{{event.eventCode === 'G' || event.eventCode === 'PG'}}">⚽</text>
                        <text class="event-icon" wx:elif="{{event.eventCode === 'OG'}}">🔴</text>
                        <text class="event-icon" wx:elif="{{event.eventCode === 'Y'}}">🟨</text>
                        <text class="event-icon" wx:elif="{{event.eventCode === 'R'}}">🟥</text>
                        <text class="event-icon dot" wx:else>●</text>
                      </view>
                      <view class="event-info">
                        <text class="event-player">{{event.personEnName}}</text>
                      </view>
                    </view>
                  </block>
                </view>
              </block>
            </view>
          </view>
        </view>

        <!-- 底部占位 -->
        <view class="bottom-placeholder"></view>
        </scroll-view>
      </view>
    </block>

    <!-- 赛果列表 -->
    <block wx:if="{{activeTab === 'result'}}">
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{results.length === 0}}">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无赛果</text>
        <text class="empty-tip">还没有比赛结果</text>
      </view>

      <!-- 赛果列表 -->
      <view class="content-wrapper" wx:else>
        <scroll-view class="results-scroll" scroll-y bindscrolltolower="onResultScrollToLower" lower-threshold="100">
        <view class="result-item {{item.statusClass}}" wx:for="{{results}}" wx:key="matchId">
          <!-- 状态指示条 -->
          <view class="result-status-bar"></view>

          <!-- 联赛和时间信息 -->
          <view class="result-header">
            <view class="league-info">
              <text class="league-tag" style="background-color: #{{item.displayColor || '667eea'}}">{{item.leagueAbbName || item.leagueName}}</text>
              <text class="status-badge {{item.statusClass}}">{{item.matchStatusName}}</text>
            </view>
            <view class="time-info">
              <text class="date">{{item.displayDate}}</text>
              <text class="time">{{item.displayTime}}</text>
            </view>
          </view>

          <!-- 对阵和比分 -->
          <view class="match-section" bindtap="onToggleExpand" data-matchid="{{item.matchId}}">
            <view class="vs-info">
              <text class="team-name home">{{item.homeName}}</text>
              <view class="score-box">
                <text class="score {{item.hadResult ? 'has-result' : ''}}">{{item.fullScore}}</text>
              </view>
              <text class="team-name away">{{item.awayName}}</text>
            </view>
            <view class="expand-btn">
              <text class="expand-icon {{expandedId === item.matchId ? 'expanded' : ''}}">^</text>
            </view>
          </view>

          <!-- 展开的开奖结果列表 -->
          <view class="odds-compact" wx:if="{{expandedId === item.matchId}}">
            <view class="odds-item" wx:if="{{item.hadResult}}">
              <text class="odds-label">胜平负</text>
              <text class="odds-result">{{item.hadCombinationDesc}}</text>
              <text class="odds-odds">{{item.hadOdds}}</text>
            </view>
            <view class="odds-item" wx:if="{{item.hhadResult}}">
              <text class="odds-label">让球</text>
              <text class="odds-result">{{item.hhadCombinationDesc}}</text>
              <text class="odds-odds">{{item.hhadOdds}}</text>
            </view>
            <view class="odds-item" wx:if="{{item.ttgResult}}">
              <text class="odds-label">总进球</text>
              <text class="odds-result">{{item.ttgCombinationDesc}}</text>
              <text class="odds-odds">{{item.ttgOdds}}</text>
            </view>
            <view class="odds-item" wx:if="{{item.hafuResult}}">
              <text class="odds-label">半全场</text>
              <text class="odds-result">{{item.hafuCombinationDesc}}</text>
              <text class="odds-odds">{{item.hafuOdds}}</text>
            </view>
            <view class="odds-item" wx:if="{{item.crsResult}}">
              <text class="odds-label">比分</text>
              <text class="odds-result">{{item.crsCombinationDesc}}</text>
              <text class="odds-odds">{{item.crsOdds}}</text>
            </view>
          </view>
        </view>

        <!-- 底部占位 -->
        <view class="bottom-placeholder"></view>
        </scroll-view>
      </view>
    </block>

    <!-- 历史记录列表 -->
    <block wx:if="{{activeTab === 'history'}}">
      <!-- 加载状态 -->
      <view class="loading-wrapper" wx:if="{{historyLoading && historyList.length === 0}}">
        <view class="loading-content">
          <view class="loading-spinner"></view>
          <text class="loading-text">加载中...</text>
        </view>
      </view>

      <!-- 错误状态 -->
      <view class="empty-state" wx:elif="{{historyError}}">
        <text class="empty-icon">⚠️</text>
        <text class="empty-text">加载失败</text>
        <text class="empty-tip">{{historyError}}</text>
        <view class="retry-btn" bindtap="onRetry">重试</view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:elif="{{historyList.length === 0}}">
        <text class="empty-icon">📝</text>
        <text class="empty-text">暂无记录</text>
        <text class="empty-tip">你还没有任何分析记录</text>
      </view>

      <!-- 历史列表 -->
      <view class="history-wrapper" wx:else>
        <!-- 历史页面内的子Tab -->
        <view class="history-sub-tabs">
          <view
            class="sub-tab-item {{historySubTab === 'list' ? 'active' : ''}}"
            data-tab="list"
            bindtap="onHistorySubTabChange"
          >
            <text class="sub-tab-text">历史记录</text>
          </view>
          <view
            class="sub-tab-item {{historySubTab === 'models' ? 'active' : ''}}"
            data-tab="models"
            bindtap="onHistorySubTabChange"
          >
            <text class="sub-tab-text">模型统计</text>
          </view>
        </view>

        <!-- 历史列表 -->
        <block wx:if="{{historySubTab === 'list'}}">
          <!-- 统计信息 -->
          <view class="stats-bar">
            <text class="stats-text">共 {{historyTotal}} 条记录</text>
          </view>

          <!-- 历史列表滚动区 -->
          <scroll-view class="history-list" scroll-y enable-back-to-top="true" bindscrolltolower="onHistoryScrollToLower" lower-threshold="100">
            <history-card
              wx:for="{{historyList}}"
              wx:key="id"
              record="{{item}}"
              bind:tap="onHistoryItemTap"
            />

            <!-- 加载更多 -->
            <view class="load-more" wx:if="{{historyHasMore}}">
              <view class="loading-spinner small" wx:if="{{historyLoading}}"></view>
              <text class="load-more-text" wx:else>上拉加载更多</text>
            </view>

            <!-- 没有更多 -->
            <view class="no-more" wx:elif="{{!historyHasMore}}">
              <text class="no-more-text">没有更多了</text>
            </view>

            <!-- 底部占位 -->
            <view class="bottom-placeholder"></view>
          </scroll-view>
        </block>

        <!-- 模型统计 -->
        <block wx:elif="{{historySubTab === 'models'}}">
          <!-- 加载状态 -->
          <view class="loading-wrapper" wx:if="{{modelsLoading}}">
            <view class="loading-content">
              <view class="loading-spinner"></view>
              <text class="loading-text">加载中...</text>
            </view>
          </view>

          <!-- 错误状态 -->
          <view class="empty-state" wx:elif="{{modelsError}}">
            <text class="empty-icon">⚠️</text>
            <text class="empty-text">加载失败</text>
            <text class="empty-tip">{{modelsError}}</text>
          </view>

          <!-- 空状态 -->
          <view class="empty-state" wx:elif="{{models.length === 0}}">
            <text class="empty-icon">📊</text>
            <text class="empty-text">暂无数据</text>
            <text class="empty-tip">还没有模型统计数据</text>
          </view>

          <!-- 模型列表 -->
          <scroll-view class="models-list" scroll-y wx:else>
            <!-- 显示模型列表或模型详情 -->
            <block wx:if="{{!modelStats}}">
              <!-- 模型列表 -->
              <view class="model-item" wx:for="{{models}}" wx:key="id" data-model-type="{{item.modelType || item.id}}" bindtap="onModelTap">
                <view class="model-item-header">
                  <view class="model-item-info">
                    <text class="model-item-name">{{item.modelName || item.name || '模型'}}</text>
                    <text class="model-item-desc">{{item.description || '模型描述'}}</text>
                  </view>
                  <text class="model-arrow">→</text>
                </view>
              </view>
            </block>

            <!-- 昨日预测报告 -->
            <block wx:else>
              <view class="report-wrapper">
                <view class="back-btn" bindtap="onModelBackClick">← 返回</view>

                <!-- 报告头部 -->
                <view class="report-header">
                  <text class="report-title">📊 昨日预测报告</text>
                  <text class="report-model">{{modelStats.modelName}}</text>
                  <view class="report-date-row">
                    <text class="report-date-label">报告生成时间</text>
                    <text class="report-date">{{modelStats.statsDate}}</text>
                  </view>
                  <text class="report-note">统计范围：昨日 03:00 - 今日 03:00 的比赛</text>
                </view>

                <!-- 核心指标 -->
                <view class="report-section">
                  <view class="key-metrics">
                    <view class="metric-card accuracy">
                      <text class="metric-value">{{modelStats.accuracyRate}}%</text>
                      <text class="metric-label">准确率</text>
                    </view>
                    <view class="metric-card">
                      <text class="metric-value">{{modelStats.correctPredictions}}</text>
                      <text class="metric-label">命中预测</text>
                    </view>
                    <view class="metric-card">
                      <text class="metric-value">{{modelStats.totalPredictions}}</text>
                      <text class="metric-label">总预测</text>
                    </view>
                  </view>
                </view>

                <!-- 预测分布 -->
                <view class="report-section">
                  <text class="section-title">预测分布</text>
                  <view class="prediction-dist">
                    <view class="dist-item">
                      <text class="dist-label">主队胜</text>
                      <view class="dist-bar">
                        <view class="dist-fill" style="width: {{modelStats.homeWinCorrect / modelStats.homeWinCount * 100}}%"></view>
                      </view>
                      <text class="dist-value">{{modelStats.homeWinCorrect}}/{{modelStats.homeWinCount}}</text>
                    </view>
                    <view class="dist-item">
                      <text class="dist-label">平局</text>
                      <view class="dist-bar">
                        <view class="dist-fill" style="width: {{modelStats.drawCorrect / modelStats.drawCount * 100}}%"></view>
                      </view>
                      <text class="dist-value">{{modelStats.drawCorrect}}/{{modelStats.drawCount}}</text>
                    </view>
                    <view class="dist-item">
                      <text class="dist-label">客队胜</text>
                      <view class="dist-bar">
                        <view class="dist-fill" style="width: {{modelStats.awayWinCorrect / modelStats.awayWinCount * 100}}%"></view>
                      </view>
                      <text class="dist-value">{{modelStats.awayWinCorrect}}/{{modelStats.awayWinCount}}</text>
                    </view>
                  </view>
                </view>

                <!-- 数据统计 -->
                <view class="report-section">
                  <text class="section-title">数据统计</text>
                  <view class="stats-table">
                    <view class="table-row">
                      <text class="table-label">样本数</text>
                      <text class="table-value">{{modelStats.sampleSize}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>

            <!-- 底部占位 -->
            <view class="bottom-placeholder"></view>
          </scroll-view>
        </block>
      </view>
    </block>


  </view>
</view>
