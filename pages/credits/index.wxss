/* pages/credits/index.wxss */
.credits-page {
  min-height: 100vh;
  background: #f8f9fc;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 24rpx 50rpx;
  color: #fff;
}

.header-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.credits-balance {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.balance-icon {
  font-size: 28rpx;
}

.balance-value {
  font-size: 28rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 28rpx;
  opacity: 0.95;
  font-weight: 500;
}

/* 套餐选择 */
.packages-section {
  padding: 32rpx 20rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 28rpx;
  padding: 0 4rpx;
}

.packages-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.packages-grid {
  display: flex;
  gap: 16rpx;
}

.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.package-card {
  flex: 1;
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 0 20rpx 32rpx;
  text-align: center;
  border: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 280rpx;
}

.package-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.02) 0%, rgba(118, 75, 162, 0.02) 100%);
  pointer-events: none;
}

.package-card:active {
  transform: translateY(-8rpx);
}

.package-card.selected {
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.25);
  border: 3rpx solid #667eea;
}

.package-card.popular {
  transform: scale(1.05);
  background: linear-gradient(135deg, #fff 0%, #f8f9fc 100%);
}

.package-card.popular.selected {
  box-shadow: 0 16rpx 40rpx rgba(102, 126, 234, 0.3);
}

.popular-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #ff9a56 0%, #ff6a88 100%);
  color: #fff;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 106, 136, 0.3);
  z-index: 2;
}

.package-icon {
  font-size: 56rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.package-points-large {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 70rpx;
  position: relative;
  z-index: 1;
}

.points-value-large {
  font-size: 52rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1;
}

.points-unit-large {
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
  line-height: 1;
}

.package-price-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  position: relative;
  z-index: 1;
  align-items: center;
  height: 60rpx;
  justify-content: center;
}

.original-price {
  font-size: 24rpx;
  color: #ccc;
  text-decoration: line-through;
  height: 30rpx;
  line-height: 30rpx;
}

.current-price {
  font-size: 44rpx;
  font-weight: 900;
  color: #333;
  height: 50rpx;
  line-height: 50rpx;
}

.check-mark {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  z-index: 2;
}

/* 功能说明 */
.features-section {
  padding: 0 24rpx 40rpx;
}

.features-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.feature-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.feature-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.feature-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 充值按钮 */
.purchase-section {
  padding: 0 24rpx 40rpx;
}

.purchase-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

.purchase-btn::after {
  border: none;
}

.purchase-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.purchase-btn.disabled {
  background: #ccc;
  box-shadow: none;
}

/* 安全区域 */
.safe-area-bottom {
  height: 100rpx;
}

/* ========== 支付弹窗 ========== */
.pay-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.pay-modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.pay-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.pay-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.pay-modal-close {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.8);
}

.pay-modal-body {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pay-amount {
  text-align: center;
  margin-bottom: 32rpx;
}

.amount-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.amount-value {
  display: block;
  font-size: 56rpx;
  font-weight: 900;
  color: #ff5858;
}

.qrcode-container {
  width: 400rpx;
  height: 400rpx;
  margin-bottom: 24rpx;
  background: #f8f9fc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pay-qrcode {
  width: 100%;
  height: 100%;
}

.qrcode-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 26rpx;
}

.pay-tips {
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

.pay-actions {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx 32rpx;
}

.pay-action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
  margin: 0;
  padding: 0;
}

.pay-action-btn::after {
  border: none;
}

.pay-action-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.pay-action-btn.confirm {
  background: linear-gradient(135deg, #07c160 0%, #04be02 100%);
  color: #fff;
}

/* ========== 客服充值弹窗 ========== */
.customer-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.customer-modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin: 0 60rpx;
}

.customer-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 0;
}

.customer-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.customer-modal-close {
  font-size: 48rpx;
  color: #ccc;
  font-weight: 300;
  line-height: 1;
}

.customer-modal-body {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.customer-tips {
  text-align: center;
  margin-bottom: 24rpx;
}

.customer-tip-text {
  font-size: 26rpx;
  color: #666;
}

.customer-qrcode-container {
  width: 400rpx;
  height: 400rpx;
  background: #f8f9fc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.customer-qrcode {
  width: 100%;
  height: 100%;
}

.customer-package-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
}

.customer-package-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.customer-price-text {
  font-size: 32rpx;
  color: #ffd700;
  font-weight: bold;
}

.customer-actions {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx 32rpx;
}

.customer-action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
  margin: 0;
  padding: 0;
}

.customer-action-btn::after {
  border: none;
}

.customer-action-btn.save {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.customer-action-btn.close {
  background: #f0f0f0;
  color: #666;
}
