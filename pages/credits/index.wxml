<!-- pages/credits/index.wxml -->
<view class="credits-page">
  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <view class="header-top">
        <text class="header-title">积分充值</text>
        <view class="credits-balance" wx:if="{{userInfo}}">
          <text class="balance-icon">💎</text>
          <text class="balance-value">{{credits}}</text>
        </view>
      </view>
      <text class="header-desc">让您的分析更强大</text>
    </view>
  </view>

  <!-- 套餐选择 -->
  <view class="packages-section">
    <text class="section-title">选择套餐</text>
    <view class="packages-container">
      <!-- 加载状态 -->
      <view class="loading-wrapper" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      <!-- 套餐列表 -->
      <view class="packages-grid" wx:else>
        <view
          class="package-card {{selectedPackage && selectedPackage.id === item.id ? 'selected' : ''}} {{item.popular ? 'popular' : ''}}"
          wx:for="{{packages}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSelectPackage"
        >
          <!-- 热销标签 -->
          <view class="popular-badge" wx:if="{{item.popular}}">
            <text>超值</text>
          </view>

          <!-- 卡片内容 -->
          <view class="package-icon">{{item.icon}}</view>

          <!-- 积分显示 -->
          <view class="package-points-large">
            <text class="points-value-large">{{item.credits}}</text>
            <text class="points-unit-large">积分</text>
          </view>

          <!-- 价格信息 -->
          <view class="package-price-info">
            <text class="current-price">¥{{item.price}}</text>
          </view>

          <!-- 选中标记 -->
          <view class="check-mark" wx:if="{{selectedPackage && selectedPackage.id === item.id}}">
            <text>✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能说明 -->
  <view class="features-section">
    <text class="section-title">积分用途</text>
    <view class="features-list">
      <view class="feature-item">
        <view class="feature-icon">🤖</view>
        <view class="feature-text">
          <text class="feature-name">AI分析</text>
          <text class="feature-desc">消耗1积分解锁每场比赛AI智能分析</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon">📰</view>
        <view class="feature-text">
          <text class="feature-name">赛事情报</text>
          <text class="feature-desc">消耗积分解锁专业情报分析报告</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon">🎯</view>
        <view class="feature-text">
          <text class="feature-name">客服</text>
          <text class="feature-desc">24小时专属客服，定制需求</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 充值按钮 -->
  <view class="purchase-section">
    <button
      class="purchase-btn {{!selectedPackage ? 'disabled' : ''}}"
      bindtap="onConfirmPurchase"
    >
      {{selectedPackage ? '立即充值 ' + selectedPackage.credits + ' 积分' : '请选择套餐'}}
    </button>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-area-bottom"></view>

  <!-- 支付弹窗 -->
  <view class="pay-modal-mask" wx:if="{{showPayModal}}" bindtap="onClosePayModal">
    <view class="pay-modal-content" catchtap="preventTap">
      <view class="pay-modal-header">
        <text class="pay-modal-title">微信支付</text>
        <view class="pay-modal-close" bindtap="onClosePayModal">×</view>
      </view>

      <view class="pay-modal-body">
        <!-- 金额 -->
        <view class="pay-amount">
          <text class="amount-label">支付金额</text>
          <text class="amount-value">¥{{payAmountYuan}}</text>
        </view>

        <!-- 二维码 -->
        <view class="qrcode-container">
          <image
            class="pay-qrcode"
            src="{{qrcodeImage}}"
            mode="aspectFit"
            wx:if="{{qrcodeImage}}"
          />
          <view class="qrcode-placeholder" wx:else>
            <text>加载中...</text>
          </view>
        </view>

        <!-- 提示 -->
        <view class="pay-tips">
          <text class="tip-text">请使用微信扫描二维码支付</text>
        </view>
      </view>

      <view class="pay-actions">
        <button class="pay-action-btn cancel" bindtap="onClosePayModal">取消</button>
        <button class="pay-action-btn confirm" bindtap="onCheckPayStatus" loading="{{checkingPay}}">
          {{checkingPay ? '查询中...' : '已支付完成'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 客服充值弹窗 -->
  <view class="customer-modal-mask" wx:if="{{showCustomerModal}}" bindtap="onCloseCustomerModal">
    <view class="customer-modal-content" catchtap="preventTap">
      <view class="customer-modal-header">
        <text class="customer-modal-title">客服充值</text>
        <view class="customer-modal-close" bindtap="onCloseCustomerModal">×</view>
      </view>

      <view class="customer-modal-body">
        <view class="customer-tips">
          <text class="customer-tip-text">请扫码添加客服微信，转账后人工充值</text>
        </view>

        <!-- 客服二维码 -->
        <view class="customer-qrcode-container">
          <image
            class="customer-qrcode"
            src="https://ai-football.cn/me.png"
            mode="aspectFit"
          />
        </view>

        <view class="customer-package-info" wx:if="{{selectedPackage}}">
          <text class="customer-package-text">充值: {{selectedPackage.credits}} 积分</text>
          <text class="customer-price-text">¥{{selectedPackage.price}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
