<!-- pages/vip/index.wxml -->
<wxs module="utils">
module.exports = {
  formatPrice: function(price) {
    if (!price) return '0.00'
    return (price / 100).toFixed(2)
  },
  formatMonthPrice: function(price) {
    if (!price) return '0.0'
    return (price / 12).toFixed(1)
  },
  calcSave: function(original, current) {
    if (!original || !current) return 0
    return original - current
  }
}
</wxs>

<view class="vip-page">
  <!-- 头部背景装饰 -->
  <view class="header">
    <view class="header-bg-decoration"></view>
    <view class="header-bg-circle circle-1"></view>
    <view class="header-bg-circle circle-2"></view>
    <view class="header-content">
      <view class="header-badge">
        <text class="badge-icon">👑</text>
        <text class="badge-text">VIP会员</text>
      </view>
      <text class="header-title">开通会员</text>
      <text class="header-desc">解锁所有比赛、情报，畅享无限分析</text>
    </view>
  </view>

  <!-- VIP权益展示 -->
  <view class="benefits-section">
    <view class="benefits-header">
      <text class="benefits-title">会员专属权益</text>
      <view class="benefits-line"></view>
    </view>
    <view class="benefits-grid">
      <view class="benefit-item">
        <view class="benefit-icon-wrapper">
          <text class="benefit-icon">🎯</text>
        </view>
        <view class="benefit-info">
          <text class="benefit-name">比赛</text>
          <text class="benefit-desc">无限分析，核心XG</text>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon-wrapper">
          <text class="benefit-icon">📰</text>
        </view>
        <view class="benefit-info">
          <text class="benefit-name">情报</text>
          <text class="benefit-desc">无需解锁</text>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon-wrapper">
          <text class="benefit-icon">🚀</text>
        </view>
        <view class="benefit-info">
          <text class="benefit-name">AI分析</text>
          <text class="benefit-desc">实时获取最新分析</text>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon-wrapper">
          <text class="benefit-icon">💎</text>
        </view>
        <view class="benefit-info">
          <text class="benefit-name">积分</text>
          <text class="benefit-desc">10倍积分</text>
        </view>
      </view>
     
      <view class="benefit-item">
        <view class="benefit-icon-wrapper">
          <text class="benefit-icon">👨‍💼</text>
        </view>
        <view class="benefit-info">
          <text class="benefit-name">专属客服</text>
          <text class="benefit-desc">7×24小时服务</text>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon-wrapper">
          <text class="benefit-icon">🎁</text>
        </view>
        <view class="benefit-info">
          <text class="benefit-name">更多权益</text>
          <text class="benefit-desc">敬请期待</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 会员状态 - 已是会员 -->
  <view class="status-section" wx:if="{{isLoggedIn && userInfo && userInfo.isVip}}">
    <view class="vip-status-card">
      <view class="status-bg-glow"></view>
      <view class="status-crown-wrapper">
        <view class="status-crown-diamond"></view>
      </view>
      <view class="status-center">
        <text class="status-title">尊贵会员</text>
        <text class="status-expire">到期时间: {{vipExpireTimeStr || '永久'}}</text>
      </view>
      <view class="status-renew-btn" bindtap="scrollToPackages">
        <text>续费会员</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载套餐中...</text>
  </view>

  <!-- 套餐选择 -->
  <view class="packages-section" wx:elif="{{showVipPurchase && packages.length > 0}}">
    <view class="section-header">
      <text class="section-title">选择套餐</text>
      <text class="section-subtitle">限时特惠 · 立省更多</text>
    </view>
    <view class="packages-container">
      <block wx:for="{{packages}}" wx:key="id">
        <view
          class="package-card {{item.popular ? 'popular' : ''}} {{selectedPackage && selectedPackage.id == item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectPackage"
        >
          <!-- 推荐丝带 -->
          <view class="popular-ribbon" wx:if="{{item.popular}}">
            <text>推荐</text>
          </view>
          
          <view class="package-header">
            <text class="package-name">{{item.name}}</text>
            <view class="best-value-tag" wx:if="{{item.popular}}">
              <text>超值</text>
            </view>
          </view>
          
          <view class="package-icon-box">
            <text class="package-emoji">{{item.icon}}</text>
          </view>
          
          <view class="package-duration">
            <text class="duration-num">{{item.duration}}</text>
            <text class="duration-unit">{{item.durationUnit}}</text>
          </view>
          
          <view class="package-price">
            <view class="price-original" wx:if="{{item.originalPrice > item.price}}">
              <text>¥</text>
              <text class="original-num">{{item.originalPrice}}</text>
            </view>
            <view class="price-current">
              <text class="currency">¥</text>
              <text class="price-num">{{item.price}}</text>
            </view>
          </view>
          
          <view class="package-save hot" wx:if="{{item.originalPrice > item.price}}">
            <text>立省¥{{utils.calcSave(item.originalPrice, item.price)}}</text>
          </view>
          
          <view class="package-avg" wx:if="{{item.popular}}">
            <text>约¥{{utils.formatMonthPrice(item.price)}}/月</text>
          </view>
          
          <view class="check-indicator" wx:if="{{selectedPackage && selectedPackage.id == item.id}}">
            <text>✓</text>
          </view>
          
          <view class="card-shine" wx:if="{{item.popular}}"></view>
        </view>
      </block>
    </view>

    <!-- 购买按钮 -->
    <view class="purchase-btn-wrapper">
      <button class="purchase-btn" bindtap="onConfirmPurchase">
        <text class="btn-icon">💳</text>
        <text class="btn-text">立即开通 {{selectedPackage ? selectedPackage.name : ''}}</text>
      </button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-packages" wx:elif="{{!loading && packages.length === 0}}">
    <text class="empty-emoji">📦</text>
    <text class="empty-title">暂无可购买套餐</text>
    <text class="empty-sub">敬请期待更多优惠</text>
  </view>

  <!-- FAQ -->
  <view class="faq-section" wx:if="{{showVipPurchase}}">
    <view class="section-header">
      <text class="section-title">常见问题</text>
    </view>
    <view class="faq-list">
      <view class="faq-item {{faqOpen[0] ? 'active' : ''}}" bindtap="toggleFaq" data-index="0">
        <view class="faq-header">
          <view class="faq-icon-wrapper">
            <text class="faq-icon">❓</text>
          </view>
          <text class="faq-title">会员有效期是多久？</text>
          <view class="faq-toggle {{faqOpen[0] ? 'open' : ''}}">
            <text>›</text>
          </view>
        </view>
        <view class="faq-content" wx:if="{{faqOpen[0]}}">
          <text>月卡有效期为30天，年卡有效期为365天，从激活之日起计算。</text>
        </view>
      </view>
      <view class="faq-item {{faqOpen[1] ? 'active' : ''}}" bindtap="toggleFaq" data-index="1">
        <view class="faq-header">
          <view class="faq-icon-wrapper">
            <text class="faq-icon">🔄</text>
          </view>
          <text class="faq-title">会员过期后怎么办？</text>
          <view class="faq-toggle {{faqOpen[1] ? 'open' : ''}}">
            <text>›</text>
          </view>
        </view>
        <view class="faq-content" wx:if="{{faqOpen[1]}}">
          <text>会员过期后可随时续费，续费后立即恢复会员权益。</text>
        </view>
      </view>
      <view class="faq-item {{faqOpen[2] ? 'active' : ''}}" bindtap="toggleFaq" data-index="2">
        <view class="faq-header">
          <view class="faq-icon-wrapper">
            <text class="faq-icon">💰</text>
          </view>
          <text class="faq-title">支持退款吗？</text>
          <view class="faq-toggle {{faqOpen[2] ? 'open' : ''}}">
            <text>›</text>
          </view>
        </view>
        <view class="faq-content" wx:if="{{faqOpen[2]}}">
          <text>虚拟商品不支持退款，建议先了解会员权益再购买。</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 支付二维码弹窗 -->
  <view class="pay-modal {{showPayModal ? 'show' : ''}}" wx:if="{{showPayModal}}">
    <view class="pay-modal-mask" bindtap="onClosePayModal"></view>
    <view class="pay-modal-content">
      <view class="pay-modal-header">
        <text class="pay-modal-title">{{isCreditsPay ? '积分充值' : '扫码支付'}}</text>
        <view class="pay-modal-close" bindtap="onClosePayModal">×</view>
      </view>

      <view class="pay-amount">
        <text class="pay-amount-label">支付金额</text>
        <text class="pay-amount-value">¥{{payAmount ? utils.formatPrice(payAmount) : '0.00'}}</text>
      </view>

      <view class="pay-qrcode-wrapper">
        <!-- 显示二维码图片 -->
        <image class="pay-qrcode" src="{{qrcodeImage}}" mode="aspectFit" wx:if="{{qrcodeImage}}" />
        <!-- 生成失败时显示复制链接 -->
        <view class="qrcode-link-wrapper" wx:elif="{{qrcodeUrl}}">
          <view class="qrcode-link-box">
            <text class="qrcode-link-text">{{qrcodeUrl}}</text>
          </view>
          <button class="copy-btn" data-text="{{qrcodeUrl}}" bindtap="onCopyPayUrl">复制支付链接</button>
          <text class="qrcode-tip-manual">复制链接后在微信中打开扫码支付</text>
        </view>
        <view class="qrcode-placeholder" wx:else>
          <view class="loading-spinner-small"></view>
          <text>加载中...</text>
        </view>
      </view>

      <view class="pay-tips">
        <text class="pay-tip">请使用微信扫码支付</text>
        <text class="pay-tip-sub">支付完成后请稍等，系统将自动确认</text>
      </view>

      <view class="pay-order-info">
        <text class="order-no">订单号: {{outTradeNo}}</text>
      </view>

      <view class="pay-actions">
        <button class="pay-action-btn cancel" bindtap="onClosePayModal">取消</button>
        <button class="pay-action-btn confirm" bindtap="onCheckPayStatus" loading="{{checkingPay}}">
          {{checkingPay ? '查询中...' : '已支付完成'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 积分充值弹窗 -->
  <view class="credits-modal {{showCreditsModal ? 'show' : ''}}" wx:if="{{showCreditsModal}}">
    <view class="credits-modal-mask" bindtap="onCloseCreditsModal"></view>
    <view class="credits-modal-content">
      <view class="credits-modal-header">
        <text class="credits-modal-title">积分充值</text>
        <view class="credits-modal-close" bindtap="onCloseCreditsModal">×</view>
      </view>

      <!-- 加载状态 -->
      <view class="credits-loading" wx:if="{{creditsLoading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 积分套餐列表 -->
      <view class="credits-packages" wx:else>
        <view
          class="credits-package-card {{selectedCreditPackage && selectedCreditPackage.id == item.id ? 'selected' : ''}}"
          wx:for="{{creditPackages}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSelectCreditPackage"
        >
          <view class="credits-package-icon">{{item.icon}}</view>
          <view class="credits-package-info">
            <text class="credits-package-name">{{item.name}}</text>
            <text class="credits-package-points">{{item.credits}}积分</text>
          </view>
          <view class="credits-package-price">¥{{item.price}}</view>
          <view class="credits-check" wx:if="{{selectedCreditPackage && selectedCreditPackage.id == item.id}}">✓</view>
        </view>
      </view>

      <view class="credits-modal-actions">
        <button class="credits-confirm-btn {{!selectedCreditPackage ? 'disabled' : ''}}" bindtap="onConfirmCreditsPurchase">
          {{selectedCreditPackage ? '立即充值 ' + selectedCreditPackage.credits + ' 积分' : '请选择套餐'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 客服充值弹窗 -->
  <view class="customer-modal-mask" wx:if="{{showCustomerModal}}" bindtap="onCloseCustomerModal">
    <view class="customer-modal-content" catchtap="preventTap">
      <view class="customer-modal-header">
        <text class="customer-modal-title">客服充值</text>
        <view class="customer-modal-close" bindtap="onCloseCustomerModal">×</view>
      </view>

      <view class="customer-modal-body">
        <view class="customer-tips">
          <text class="customer-tip-text">请扫码添加客服微信，转账后人工充值</text>
        </view>

        <!-- 客服二维码 -->
        <view class="customer-qrcode-container">
          <image
            class="customer-qrcode"
            src="https://ai-football.cn/me.png"
            mode="aspectFit"
          />
        </view>

        <view class="customer-package-info" wx:if="{{selectedPackage}}">
          <text class="customer-package-text">开通: {{selectedPackage.name}}</text>
          <text class="customer-price-text">¥{{selectedPackage.price}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-area-bottom"></view>
</view>
