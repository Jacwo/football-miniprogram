<!-- pages/calculator/index.wxml -->
<view class="calculator-page">
  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-wrapper" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 主内容 -->
  <view class="main-content" wx:else>
    <!-- 页面标题（专题页来源时显示） -->
    <view class="page-title-bar" wx:if="{{source === 'topic'}}">
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-subtitle">{{matches.length}}场比赛</text>
    </view>

    <!-- 顶部Tab切换 -->
    <view class="tab-header">
      <view class="tab-item {{currentTab === 'play' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="play">
        <text class="tab-text">{{pageTitle}}</text>
      </view>
      <view class="tab-item {{currentTab === 'records' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="records">
        <text class="tab-text">我的记录</text>
        <text class="record-badge" wx:if="{{records.length > 0}}">{{records.length}}</text>
      </view>
    </view>

    <!-- 足球计算器内容 -->
    <view class="tab-content" wx:if="{{currentTab === 'play'}}">
    <!-- 比赛列表 -->
    <scroll-view class="match-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="match-card" wx:for="{{matches}}" wx:key="matchId">
        <!-- 比赛信息头 -->
        <view class="card-header">
          <text class="match-num">{{item.matchNumStr}}</text>
          <text class="league-name">{{item.leagueAbbName}}</text>
          <text class="match-time">{{item.matchTime}}</text>
          <!-- 单关标记 -->
          <text class="single-tag" wx:if="{{item.bettingSingle == 1 || item.bettingSingle == true}}">单</text>
        </view>

        <!-- 对阵信息 -->
        <view class="team-row">
          <text class="team-name home">{{item.homeTeamAbbName}}</text>
          <text class="vs-text">VS</text>
          <text class="team-name away">{{item.awayTeamAbbName}}</text>
        </view>

        <!-- AI帮选 -->
        <view class="ai-recommend {{selectedMap[item.matchId + '_had_' + item.aiHadValue] || selectedMap[item.matchId + '_hhad_' + item.aiHhadValue] ? 'ai-selected' : ''}}"
              wx:if="{{item.aiResult || item.aiLetResult}}"
              data-matchid="{{item.matchId}}"
              data-hadv="{{item.aiHadValue}}" data-hadodds="{{item.aiHadOdds}}"
              data-hhadv="{{item.aiHhadValue}}" data-hhadodds="{{item.aiHhadOdds}}"
              bindtap="onAiRecommendTap">
          <view class="ai-bar-inner">
            <text class="ai-bar-icon">✨</text>
            <text class="ai-bar-text">AI帮选 · 一键勾选推荐结果</text>
            <text class="ai-bar-arrow">→</text>
          </view>
        </view>

        <!-- 赔率区域 -->
        <view class="odds-wrapper">
          <view class="odds-left">
            <!-- 胜平负 -->
            <view class="odds-section">
              <view class="odds-inline-row">
                <text class="section-title">胜平负</text>
                <view class="odds-group {{item.bettingSingle == 1 || item.bettingSingle == true ? 'single' : ''}}">
                  <text class="single-corner" wx:if="{{item.bettingSingle == 1 || item.bettingSingle == true}}">单</text>
                  <view class="odds-item {{!item.hadH ? 'disabled' : ''}} {{selectedMap[item.matchId + '_had_H'] ? 'active' : ''}}" data-matchid="{{item.matchId}}" data-type="had" data-value="H" data-odds="{{item.hadH}}" bindtap="onSelectOption">
                    <text class="odds-label">胜</text>
                    <text class="odds-value">{{item.hadH || '未受注'}}</text>
                  </view>
                  <view class="odds-item {{!item.hadD ? 'disabled' : ''}} {{selectedMap[item.matchId + '_had_D'] ? 'active' : ''}}" data-matchid="{{item.matchId}}" data-type="had" data-value="D" data-odds="{{item.hadD}}" bindtap="onSelectOption">
                    <text class="odds-label">平</text>
                    <text class="odds-value">{{item.hadD || '未受注'}}</text>
                  </view>
                  <view class="odds-item {{!item.hadA ? 'disabled' : ''}} {{selectedMap[item.matchId + '_had_A'] ? 'active' : ''}}" data-matchid="{{item.matchId}}" data-type="had" data-value="A" data-odds="{{item.hadA}}" bindtap="onSelectOption">
                    <text class="odds-label">负</text>
                    <text class="odds-value">{{item.hadA || '未受注'}}</text>
                  </view>
                </view>
              </view>
            </view>

            <!-- 让球胜平负 -->
            <view class="odds-section last">
              <view class="odds-inline-row">
                <text class="section-title">让球<text class="goalline">({{item.hhadGoalLine}})</text></text>
                <view class="odds-group {{item.bettingAllUp == 1 || item.bettingAllUp == true ? 'single' : ''}}">
                  <text class="single-corner" wx:if="{{item.bettingAllUp == 1 || item.bettingAllUp == true}}">单</text>
                  <view class="odds-item {{!item.hhadH ? 'disabled' : ''}} {{selectedMap[item.matchId + '_hhad_H'] ? 'active' : ''}}" data-matchid="{{item.matchId}}" data-type="hhad" data-value="H" data-odds="{{item.hhadH}}" bindtap="onSelectOption">
                    <text class="odds-label">胜</text>
                    <text class="odds-value">{{item.hhadH || '-'}}</text>
                  </view>
                  <view class="odds-item {{!item.hhadD ? 'disabled' : ''}} {{selectedMap[item.matchId + '_hhad_D'] ? 'active' : ''}}" data-matchid="{{item.matchId}}" data-type="hhad" data-value="D" data-odds="{{item.hhadD}}" bindtap="onSelectOption">
                    <text class="odds-label">平</text>
                    <text class="odds-value">{{item.hhadD || '-'}}</text>
                  </view>
                  <view class="odds-item {{!item.hhadA ? 'disabled' : ''}} {{selectedMap[item.matchId + '_hhad_A'] ? 'active' : ''}}" data-matchid="{{item.matchId}}" data-type="hhad" data-value="A" data-odds="{{item.hhadA}}" bindtap="onSelectOption">
                    <text class="odds-label">负</text>
                    <text class="odds-value">{{item.hhadA || '-'}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- 右侧更多玩法 -->
          <view class="card-right" data-match="{{item}}" bindtap="onMorePlays">
            <text class="more-text">更</text>
            <text class="more-text">多</text>
          </view>
        </view>

        <!-- 选中标记 -->
        <view class="selected-badge" wx:if="{{selections[item.matchId].length > 0}}">
          已选{{selections[item.matchId].length}}项
        </view>
      </view>

      <!-- 底部占位 -->
      <view class="bottom-placeholder"></view>
    </scroll-view>
    </view>

    <!-- 我的记录内容 -->
    <view class="tab-content records-content" wx:if="{{currentTab === 'records'}}">
      <view class="records-loading" wx:if="{{recordsLoading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      <view class="records-empty" wx:elif="{{records.length === 0}}">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无记录</text>
        <text class="empty-tip">保存足球计算器方案后记录将显示在这里</text>
      </view>
      <scroll-view class="records-scroll" scroll-y wx:else>
        <view class="record-swipe-wrapper" wx:for="{{records}}" wx:key="id">
          <view class="record-swipe-inner {{item.swiped ? 'swiped' : ''}} {{item.status === 1 ? 'win' : (item.status === 2 ? 'lose' : 'pending')}}"
                data-index="{{index}}"
                bindtouchstart="onTouchStart"
                bindtouchmove="onTouchMove"
                bindtouchend="onTouchEnd">
            <view class="record-card" bindtap="onRecordTap" data-record="{{item}}">
              <!-- 左侧日期 -->
              <view class="record-date-box">
                <text class="date-month">{{item.monthDay}}</text>
                <text class="date-time">{{item.hourMinute}}</text>
              </view>
              <!-- 右侧内容 -->
              <view class="record-content">
                <!-- 状态标签 - 右上角 -->
                <view class="record-status-tag {{item.status === 1 ? 'win' : (item.status === 2 ? 'lose' : 'pending')}}">
                  <text class="status-text">{{item.statusDesc}}</text>
                </view>
                <view class="record-title-row">
                  <text class="record-matches">{{item.matchCount}}场比赛</text>
                  <text class="record-pass">{{item.passTypesStr}}</text>
                </view>
                <view class="record-amount-row">
                  <text class="record-amount">¥{{item.totalAmount}}</text>
                  <text class="record-bonus" wx:if="{{item.status === 1 && item.bonus > 0}}">中奖 ¥{{item.bonus}}</text>
                </view>
              </view>
            </view>
            <view class="record-delete-btn" catchtap="onDeleteRecord" data-id="{{item.id}}" data-index="{{index}}">
              <text class="delete-text">删除</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 底部操作栏 - 仅在足球计算器tab显示 -->
    <view class="bottom-bar" wx:if="{{currentTab === 'play'}}">
      <!-- 过关方式选择 -->
      <view class="pass-type-row" wx:if="{{availablePassTypes.length > 0}}">
        <view class="pass-btn {{selectedPassTypesMap[item.value] ? 'active' : ''}}" wx:for="{{availablePassTypes}}" wx:key="value" data-value="{{item.value}}" bindtap="onSelectPassType">
          {{item.label}}
        </view>
      </view>
      <view class="pass-type-empty" wx:else>
        <text class="empty-tip">请先选择比赛</text>
      </view>

      <!-- 倍数和金额 -->
      <view class="amount-row">
        <view class="multiple-box">
          <text class="label">倍数</text>
          <view class="stepper">
            <view class="stepper-btn" bindtap="onMultipleMinus">-</view>
            <input class="stepper-input" type="number" value="{{multipleInput}}" bindinput="onMultipleInput" bindblur="onMultipleBlur" />
            <view class="stepper-btn" bindtap="onMultiplePlus">+</view>
          </view>
        </view>
        <view class="amount-info">
          <text class="amount-label">{{totalBets}}注 / {{totalAmount}}元</text>
          <text class="bonus-text" wx:if="{{totalBets > 0}}">预计奖金: {{minBonus}}-{{maxBonus}}元</text>
        </view>
        <view class="submit-btn {{totalBets > 0 ? '' : 'disabled'}}" bindtap="onSubmit">保存</view>
      </view>
    </view>
  </view>

  <!-- 更多玩法弹窗 -->
  <view class="popup-mask" wx:if="{{showMorePlays}}" bindtap="onCloseMorePlays">
    <view class="popup-content" catchtap="onPreventTap">
      <!-- 弹窗头部 -->
      <view class="popup-header">
        <text class="popup-title" wx:if="{{currentMatch}}">{{currentMatch.homeTeamAbbName}} VS {{currentMatch.awayTeamAbbName}}</text>
        <view class="popup-close" bindtap="onCloseMorePlays">×</view>
      </view>

      <!-- 单关提示 -->
      <text class="popup-tip" >红色框选项可投单关</text>

      <!-- 弹窗内容 -->
      <view class="popup-body" wx:if="{{currentMatch}}">
        <!-- 胜平负 -->
        <view class="play-row">
          <view class="play-label had-label">0</view>
          <view class="play-options {{currentMatch.bettingSingle == 1 || currentMatch.bettingSingle == true ? 'single-group' : ''}}">
            <view class="opt-item {{!currentMatch.hadH ? 'disabled' : ''}} {{selectedMap[currentMatch.matchId + '_had_H'] ? 'active' : ''}}" data-matchid="{{currentMatch.matchId}}" data-type="had" data-value="H" data-odds="{{currentMatch.hadH}}" bindtap="onSelectOption">
              <text class="single-corner" wx:if="{{currentMatch.bettingSingle == 1 || currentMatch.bettingSingle == true}}">单</text>
              <text class="opt-text">胜</text>
              <text class="opt-odds">{{currentMatch.hadH || '未受注'}}</text>
            </view>
            <view class="opt-item {{!currentMatch.hadD ? 'disabled' : ''}} {{selectedMap[currentMatch.matchId + '_had_D'] ? 'active' : ''}}" data-matchid="{{currentMatch.matchId}}" data-type="had" data-value="D" data-odds="{{currentMatch.hadD}}" bindtap="onSelectOption">
              <text class="opt-text">平</text>
              <text class="opt-odds">{{currentMatch.hadD || '未受注'}}</text>
            </view>
            <view class="opt-item {{!currentMatch.hadA ? 'disabled' : ''}} {{selectedMap[currentMatch.matchId + '_had_A'] ? 'active' : ''}}" data-matchid="{{currentMatch.matchId}}" data-type="had" data-value="A" data-odds="{{currentMatch.hadA}}" bindtap="onSelectOption">
              <text class="opt-text">负</text>
              <text class="opt-odds">{{currentMatch.hadA || '未受注'}}</text>
            </view>
          </view>
        </view>

        <!-- 让球胜平负 -->
        <view class="play-row">
          <view class="play-label hhad-label">{{currentMatch.hhadGoalLine}}</view>
          <view class="play-options {{currentMatch.bettingAllUp == 1 || currentMatch.bettingAllUp == true ? 'single-group' : ''}}">
            <view class="opt-item {{!currentMatch.hhadH ? 'disabled' : ''}} {{selectedMap[currentMatch.matchId + '_hhad_H'] ? 'active' : ''}}" data-matchid="{{currentMatch.matchId}}" data-type="hhad" data-value="H" data-odds="{{currentMatch.hhadH}}" bindtap="onSelectOption">
              <text class="single-corner" wx:if="{{currentMatch.bettingAllUp == 1 || currentMatch.bettingAllUp == true}}">单</text>
              <text class="opt-text">胜</text>
              <text class="opt-odds">{{currentMatch.hhadH || '-'}}</text>
            </view>
            <view class="opt-item {{!currentMatch.hhadD ? 'disabled' : ''}} {{selectedMap[currentMatch.matchId + '_hhad_D'] ? 'active' : ''}}" data-matchid="{{currentMatch.matchId}}" data-type="hhad" data-value="D" data-odds="{{currentMatch.hhadD}}" bindtap="onSelectOption">
              <text class="opt-text">平</text>
              <text class="opt-odds">{{currentMatch.hhadD || '-'}}</text>
            </view>
            <view class="opt-item {{!currentMatch.hhadA ? 'disabled' : ''}} {{selectedMap[currentMatch.matchId + '_hhad_A'] ? 'active' : ''}}" data-matchid="{{currentMatch.matchId}}" data-type="hhad" data-value="A" data-odds="{{currentMatch.hhadA}}" bindtap="onSelectOption">
              <text class="opt-text">负</text>
              <text class="opt-odds">{{currentMatch.hhadA || '-'}}</text>
            </view>
          </view>
        </view>

        <!-- 比分 -->
        <view class="play-row crs-row">
          <view class="play-label crs-label">比分</view>
          <view class="play-options crs-options single-group">
            <!-- 胜 -->
            <view class="crs-grid">
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_1:0'] ? 'active' : ''}}" data-score="1:0" data-odds="{{currentMatch.crsS01s00}}" bindtap="onSelectScore"><text class="single-corner">单</text><text class="crs-name">1:0</text><text class="crs-odds">{{currentMatch.crsS01s00}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_2:0'] ? 'active' : ''}}" data-score="2:0" data-odds="{{currentMatch.crsS02s00}}" bindtap="onSelectScore"><text class="crs-name">2:0</text><text class="crs-odds">{{currentMatch.crsS02s00}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_2:1'] ? 'active' : ''}}" data-score="2:1" data-odds="{{currentMatch.crsS02s01}}" bindtap="onSelectScore"><text class="crs-name">2:1</text><text class="crs-odds">{{currentMatch.crsS02s01}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_3:0'] ? 'active' : ''}}" data-score="3:0" data-odds="{{currentMatch.crsS03s00}}" bindtap="onSelectScore"><text class="crs-name">3:0</text><text class="crs-odds">{{currentMatch.crsS03s00}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_3:1'] ? 'active' : ''}}" data-score="3:1" data-odds="{{currentMatch.crsS03s01}}" bindtap="onSelectScore"><text class="crs-name">3:1</text><text class="crs-odds">{{currentMatch.crsS03s01}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_3:2'] ? 'active' : ''}}" data-score="3:2" data-odds="{{currentMatch.crsS03s02}}" bindtap="onSelectScore"><text class="crs-name">3:2</text><text class="crs-odds">{{currentMatch.crsS03s02}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_4:0'] ? 'active' : ''}}" data-score="4:0" data-odds="{{currentMatch.crsS04s00}}" bindtap="onSelectScore"><text class="crs-name">4:0</text><text class="crs-odds">{{currentMatch.crsS04s00}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_4:1'] ? 'active' : ''}}" data-score="4:1" data-odds="{{currentMatch.crsS04s01}}" bindtap="onSelectScore"><text class="crs-name">4:1</text><text class="crs-odds">{{currentMatch.crsS04s01}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_4:2'] ? 'active' : ''}}" data-score="4:2" data-odds="{{currentMatch.crsS04s02}}" bindtap="onSelectScore"><text class="crs-name">4:2</text><text class="crs-odds">{{currentMatch.crsS04s02}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_5:0'] ? 'active' : ''}}" data-score="5:0" data-odds="{{currentMatch.crsS05s00}}" bindtap="onSelectScore"><text class="crs-name">5:0</text><text class="crs-odds">{{currentMatch.crsS05s00}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_5:1'] ? 'active' : ''}}" data-score="5:1" data-odds="{{currentMatch.crsS05s01}}" bindtap="onSelectScore"><text class="crs-name">5:1</text><text class="crs-odds">{{currentMatch.crsS05s01}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_5:2'] ? 'active' : ''}}" data-score="5:2" data-odds="{{currentMatch.crsS05s02}}" bindtap="onSelectScore"><text class="crs-name">5:2</text><text class="crs-odds">{{currentMatch.crsS05s02}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_胜其他'] ? 'active' : ''}}" data-score="胜其他" data-odds="{{currentMatch.crsS1sh}}" bindtap="onSelectScore"><text class="crs-name">胜其他</text><text class="crs-odds">{{currentMatch.crsS1sh}}</text></view>
            </view>
            <!-- 平 -->
            <view class="crs-grid">
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_0:0'] ? 'active' : ''}}" data-score="0:0" data-odds="{{currentMatch.crsS00s00}}" bindtap="onSelectScore"><text class="crs-name">0:0</text><text class="crs-odds">{{currentMatch.crsS00s00}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_1:1'] ? 'active' : ''}}" data-score="1:1" data-odds="{{currentMatch.crsS01s01}}" bindtap="onSelectScore"><text class="crs-name">1:1</text><text class="crs-odds">{{currentMatch.crsS01s01}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_2:2'] ? 'active' : ''}}" data-score="2:2" data-odds="{{currentMatch.crsS02s02}}" bindtap="onSelectScore"><text class="crs-name">2:2</text><text class="crs-odds">{{currentMatch.crsS02s02}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_3:3'] ? 'active' : ''}}" data-score="3:3" data-odds="{{currentMatch.crsS03s03}}" bindtap="onSelectScore"><text class="crs-name">3:3</text><text class="crs-odds">{{currentMatch.crsS03s03}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_平其他'] ? 'active' : ''}}" data-score="平其他" data-odds="{{currentMatch.crsS1sd}}" bindtap="onSelectScore"><text class="crs-name">平其他</text><text class="crs-odds">{{currentMatch.crsS1sd}}</text></view>
            </view>
            <!-- 负 -->
            <view class="crs-grid">
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_0:1'] ? 'active' : ''}}" data-score="0:1" data-odds="{{currentMatch.crsS00s01}}" bindtap="onSelectScore"><text class="crs-name">0:1</text><text class="crs-odds">{{currentMatch.crsS00s01}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_0:2'] ? 'active' : ''}}" data-score="0:2" data-odds="{{currentMatch.crsS00s02}}" bindtap="onSelectScore"><text class="crs-name">0:2</text><text class="crs-odds">{{currentMatch.crsS00s02}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_1:2'] ? 'active' : ''}}" data-score="1:2" data-odds="{{currentMatch.crsS01s02}}" bindtap="onSelectScore"><text class="crs-name">1:2</text><text class="crs-odds">{{currentMatch.crsS01s02}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_0:3'] ? 'active' : ''}}" data-score="0:3" data-odds="{{currentMatch.crsS00s03}}" bindtap="onSelectScore"><text class="crs-name">0:3</text><text class="crs-odds">{{currentMatch.crsS00s03}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_1:3'] ? 'active' : ''}}" data-score="1:3" data-odds="{{currentMatch.crsS01s03}}" bindtap="onSelectScore"><text class="crs-name">1:3</text><text class="crs-odds">{{currentMatch.crsS01s03}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_2:3'] ? 'active' : ''}}" data-score="2:3" data-odds="{{currentMatch.crsS02s03}}" bindtap="onSelectScore"><text class="crs-name">2:3</text><text class="crs-odds">{{currentMatch.crsS02s03}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_0:4'] ? 'active' : ''}}" data-score="0:4" data-odds="{{currentMatch.crsS00s04}}" bindtap="onSelectScore"><text class="crs-name">0:4</text><text class="crs-odds">{{currentMatch.crsS00s04}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_1:4'] ? 'active' : ''}}" data-score="1:4" data-odds="{{currentMatch.crsS01s04}}" bindtap="onSelectScore"><text class="crs-name">1:4</text><text class="crs-odds">{{currentMatch.crsS01s04}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_2:4'] ? 'active' : ''}}" data-score="2:4" data-odds="{{currentMatch.crsS02s04}}" bindtap="onSelectScore"><text class="crs-name">2:4</text><text class="crs-odds">{{currentMatch.crsS02s04}}</text></view>
              <view class="crs-item {{selectedMap[currentMatch.matchId + '_crs_0:5'] ? 'active' : ''}}" data-score="0:5" data-odds="{{currentMatch.crsS00s05}}" bindtap="onSelectScore"><text class="crs-name">0:5</text><text class="crs-odds">{{currentMatch.crsS00s05}}</text></view>
