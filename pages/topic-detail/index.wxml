<!-- pages/topic-detail/index.wxml - 专题详情页 -->
<view class="topic-detail-page">
  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-wrapper" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 主内容 -->
  <scroll-view class="detail-scroll" scroll-y enable-back-to-top="true" wx:else>
    <!-- 专题封面图 -->
    <view class="topic-header" wx:if="{{topicInfo.imageUrl}}">
      <image class="topic-cover" src="{{topicInfo.imageUrl}}" mode="widthFix" />
      <view class="topic-info-overlay">
        <text class="topic-title">{{topicInfo.topicName}}</text>
        <text class="topic-desc" wx:if="{{topicInfo.topicDesc}}">{{topicInfo.topicDesc}}</text>
      </view>
    </view>

    <!-- 已完成比赛 - 滚动加载 -->
    <view class="section" wx:if="{{finishedMatches.length > 0}}">
      <view class="section-bar">
        <view class="section-bar-dot hot"></view>
        <text class="section-bar-title">已完成比赛</text>
        <text class="section-bar-extra">{{finishedDisplayMatches.length}}/{{finishedMatches.length}}场</text>
      </view>
      <view class="match-list">
        <view class="match-card-item" wx:for="{{finishedDisplayMatches}}" wx:key="matchId">
          <view class="match-card" bindtap="onMatchTap" data-matchid="{{item.matchId}}">
            <view class="card-header">
              <view class="header-left">
                <text class="match-num">{{item.matchNumStr}}</text>
                <text class="league-tag">{{item.leagueAbbName}}</text>
              </view>
              <view class="header-right">
                <text class="match-status finished">已结束</text>
              </view>
            </view>
            <view class="teams-row">
              <view class="team-info home">
                <text class="team-name">{{item.homeTeamAbbName}}</text>
                <text class="team-rank" wx:if="{{item.homeTeamRank}}">[{{item.homeTeamRank}}]</text>
              </view>
              <view class="score-box">
                <text class="home-score">{{item.homeScore}}</text>
                <text class="score-divider">:</text>
                <text class="away-score">{{item.awayScore}}</text>
              </view>
              <view class="team-info away">
                <text class="team-name">{{item.awayTeamAbbName}}</text>
                <text class="team-rank" wx:if="{{item.awayTeamRank}}">[{{item.awayTeamRank}}]</text>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 加载更多按钮 -->
        <view class="load-more-btn" wx:if="{{finishedHasMore}}" bindtap="onLoadMoreFinished">
          <text class="load-more-text">加载更多</text>
        </view>
      </view>
    </view>

    <!-- 待开始比赛 - Tab切换显示 -->
    <view class="section" wx:if="{{upcomingByGroup.length > 0}}">
      <view class="section-bar">
        <view class="section-bar-dot upcoming"></view>
        <text class="section-bar-title">待开始比赛</text>
      </view>
      
      <!-- 分组Tab横向导航 -->
      <view class="group-tabs-wrapper">
        <scroll-view class="group-tabs-scroll" scroll-x enable-flex="true">
          <view class="group-tabs">
            <view 
              wx:for="{{groupTabs}}" 
              wx:key="index"
              class="group-tab {{activeGroupTab === index ? 'active' : ''}}"
              data-index="{{index}}"
              bindtap="onGroupTabChange"
            >{{item}}</view>
          </view>
        </scroll-view>
      </view>
      
      <!-- 选中分组的比赛列表 -->
      <view class="match-list">
        <!-- 按日期循环 -->
        <view wx:for="{{selectedGroupMatches}}" wx:for-item="dateItem" wx:key="date">
          <!-- 日期标题 -->
          <view class="date-row">
            <text class="date-label">{{dateItem.date}}</text>
          </view>
          
          <!-- 一天内的所有比赛 -->
          <view class="day-matches-box">
            <view 
              class="match-card compact" 
              wx:for="{{dateItem.matches}}" 
              wx:for-item="matchItem" 
              wx:key="matchId"
              bindtap="onMatchTap" 
              data-matchid="{{matchItem.matchId}}"
            >
              <view class="compact-time">{{matchItem.timeOnly}}</view>
              <view class="compact-teams">
                <text class="compact-team">{{matchItem.homeTeamAbbName}}</text>
                <text class="compact-vs">VS</text>
                <text class="compact-team">{{matchItem.awayTeamAbbName}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{finishedMatches.length === 0 && upcomingByGroup.length === 0 && !loading}}">
      <text class="empty-emoji">📋</text>
      <text class="empty-title">暂无比赛数据</text>
      <text class="empty-sub">精彩比赛即将开始</text>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
