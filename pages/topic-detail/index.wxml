<!-- pages/topic-detail/index.wxml - 专题详情页 -->
<view class="topic-detail-page">
  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-wrapper" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 主内容 -->
  <view class="detail-content" wx:else>
    <!-- 世界杯专题标题 -->
    <view class="worldcup-header" wx:if="{{isWorldCup}}">
      <view class="topic-title-row">
        <text class="topic-title">{{topicInfo.topicName}}</text>
        <text class="worldcup-badge">FIFA World Cup 2026™</text>
      </view>
      <text class="worldcup-date-range">2026/06/12 - 2026/07/20 </text>
      <!-- 倒计时 -->
      <view class="countdown-section">
        <text class="countdown-number">{{countdownDays}}</text>
        <text class="countdown-label">天</text>
        <text class="countdown-number">{{countdownHours}}</text>
        <text class="countdown-label">时</text>
        <text class="countdown-number">{{countdownMins}}</text>
        <text class="countdown-label">分</text>
        <text class="countdown-number">{{countdownSecs}}</text>
        <text class="countdown-label">秒</text>
      </view>
    </view>

    <!-- 普通专题标题 -->
    <view class="topic-title-section" wx:else>
      <text class="topic-title">{{topicInfo.topicName}}</text>
      <text class="topic-desc" wx:if="{{topicInfo.topicDesc}}">{{topicInfo.topicDesc}}</text>
    </view>

    <!-- 赛程标题（固定） -->
    <view class="section-bar-fixed" wx:if="{{timelineMatches.length > 0}}">
      <view class="section-bar">
        <view class="section-bar-left">
          <view class="section-bar-dot upcoming"></view>
          <text class="section-bar-title">赛程</text>
          <text class="section-bar-extra">{{timelineMatches.length}}场</text>
        </view>
        <view class="view-groups-btn" bindtap="onViewGroups">
          <text>小组积分榜</text>
        </view>
      </view>
    </view>

    <!-- 比赛列表滚动区域 -->
    <scroll-view class="timeline-scroll" scroll-y wx:if="{{timelineMatches.length > 0}}">
      <view class="timeline">
        <view class="timeline-item" wx:for="{{timelineMatches}}" wx:key="id">
          <!-- 时间线节点 -->
          <view class="timeline-marker">
            <view class="timeline-dot"></view>
            <view class="timeline-line"></view>
          </view>

          <!-- 日期标签 -->
          <view class="timeline-date" wx:if="{{item.showDateLabel}}">
            <text class="date-badge">{{item.matchDate}}</text>
          </view>

          <!-- 比赛卡片 -->
          <view class="timeline-card" data-id="{{item.id}}" bindtap="onMatchTap">
            <view class="card-time-row">
              <text class="card-weekday">{{item.weekDay}}</text>
              <text class="card-time">{{item.matchTime}}</text>
              <text class="card-group" wx:if="{{item.groupName}}">{{item.groupName}}</text>
            </view>
            <view class="card-teams">
              <view class="team home">
                <text class="team-name">{{item.homeTeam}}</text>
              </view>
              <view class="vs-badge">
                <text class="vs-text">VS</text>
              </view>
              <view class="team away">
                <text class="team-name">{{item.awayTeam}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{timelineMatches.length === 0 && !loading}}">
      <text class="empty-emoji">📋</text>
      <text class="empty-title">暂无比赛数据</text>
      <text class="empty-sub">精彩比赛即将开始</text>
    </view>
  </view>

  <!-- 分组弹窗 -->
  <view class="groups-modal" wx:if="{{showGroupsModal}}" catchtouchmove="preventTouchMove">
    <view class="groups-mask" bindtap="onCloseGroupsModal"></view>
    <view class="groups-content">
      <view class="groups-header">
        <text class="groups-title">分组积分</text>
        <view class="groups-close" bindtap="onCloseGroupsModal">✕</view>
      </view>

      <!-- 加载状态 -->
      <view class="groups-loading" wx:if="{{groupsLoading}}">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>

      <block wx:elif="{{groupNames.length > 0}}">
        <!-- 分组Tab指示器 -->
        <scroll-view class="group-tabs-indicator" scroll-x scroll-with-animation scroll-into-view="tab{{selectedGroupIndex}}">
          <view class="group-tabs-wrapper">
            <view class="group-tab-btn {{selectedGroupIndex === index ? 'active' : ''}}" wx:for="{{groupNames}}" wx:key="index" id="tab{{index}}" data-index="{{index}}" bindtap="onTabTap">
              {{item}}
            </view>
          </view>
        </scroll-view>

        <!-- 分组滑动视图 -->
        <swiper 
          class="groups-swiper" 
          current="{{selectedGroupIndex}}" 
          bindchange="onGroupSwiperChange"
        >
          <swiper-item wx:for="{{groupNames}}" wx:key="item">
            <scroll-view class="group-scroll" scroll-y>
              <view class="groups-table">
                <view class="table-header">
                  <text class="col-rank">排名</text>
                  <text class="col-team">球队</text>
                  <text class="col-played">赛</text>
                  <text class="col-win">胜</text>
                  <text class="col-draw">平</text>
                  <text class="col-loss">负</text>
                  <text class="col-goals">进</text>
                  <text class="col-ga">失</text>
                  <text class="col-gd">净</text>
                  <text class="col-points">积分</text>
                </view>
                <view class="table-body">
                  <view class="table-row" wx:for="{{groupList[item]}}" wx:key="id">
                    <text class="col-rank {{item.teamRank <= 2 ? 'top' : ''}}">{{item.teamRank}}</text>
                    <text class="col-team">{{item.teamName}}</text>
                    <text class="col-played">{{item.played}}</text>
                    <text class="col-win">{{item.won}}</text>
                    <text class="col-draw">{{item.drawn}}</text>
                    <text class="col-loss">{{item.lost}}</text>
                    <text class="col-goals">{{item.goalsFor}}</text>
                    <text class="col-ga">{{item.goalsAgainst}}</text>
                    <text class="col-gd {{item.goalDiff > 0 ? 'positive' : item.goalDiff < 0 ? 'negative' : ''}}">{{item.goalDiff > 0 ? '+' : ''}}{{item.goalDiff}}</text>
                    <text class="col-points {{item.teamRank <= 2 ? 'top' : ''}}">{{item.points}}</text>
                  </view>
                </view>
              </view>
            </scroll-view>
          </swiper-item>
        </swiper>

        <!-- 底部指示器 -->
        <view class="group-indicator" wx:if="{{groupNames.length > 1}}">
          <view 
            class="indicator-dot {{selectedGroupIndex === index ? 'active' : ''}}" 
            wx:for="{{groupNames}}" 
            wx:key="index"
          ></view>
        </view>
      </block>
    </view>
  </view>
</view>
