<!-- pages/topic/index.wxml -->
<view class="topic-page">
  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-wrapper" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 主内容 -->
  <view class="main-content" wx:else>
    <!-- 页面标题 -->
    <view class="page-header">
      <text class="page-title">📌 专题</text>
      <text class="page-desc">了解足球热门话题</text>
    </view>

    <!-- 内容区域 -->
    <scroll-view class="topic-content" scroll-y enable-back-to-top="true">
      <!-- 今日热门比赛 -->
      <view class="topic-section" wx:if="{{hotMatches.length > 0}}">
        <text class="section-title">🔥 今日热门比赛</text>
        <view class="items-container">
          <view class="match-item" wx:for="{{hotMatches}}" wx:key="matchId">
            <!-- 比赛头部 -->
            <view class="match-top">
              <view class="league-badge" style="background-color: #{{item.backColor}}">
                <text class="league-text">{{item.leagueAbbName}}</text>
              </view>
              <text class="match-time">{{item.matchTime}}</text>
              <text class="match-status">{{item.matchStatusName}}</text>
            </view>

            <!-- 对阵信息 -->
            <view class="match-vs-section">
              <view class="team-info home">
                <text class="team-name">{{item.homeTeamAbbName}}</text>
                <view class="team-rank">排名 {{item.homeTeamRank}}</view>
                <view class="trend {{item.homeFormTrend === '上升' ? 'up' : 'down'}}">
                  <text class="trend-icon">{{item.homeFormTrend === '上升' ? '📈' : '📉'}}</text>
                  <text>{{item.homeFormTrend}}</text>
                </view>
              </view>

              <view class="vs-middle">
                <text class="vs">VS</text>
              </view>

              <view class="team-info away">
                <text class="team-name">{{item.awayTeamAbbName}}</text>
                <view class="team-rank">排名 {{item.awayTeamRank}}</view>
                <view class="trend {{item.awayFormTrend === '上升' ? 'up' : 'down'}}">
                  <text class="trend-icon">{{item.awayFormTrend === '上升' ? '📈' : '📉'}}</text>
                  <text>{{item.awayFormTrend}}</text>
                </view>
              </view>
            </view>

            <!-- 赔率信息 -->
            <view class="odds-section">
              <view class="odds-item">
                <text class="odds-label">{{item.homeTeamAbbName}}胜</text>
                <text class="odds-value">{{item.homeWin}}</text>
              </view>
              <view class="odds-item">
                <text class="odds-label">平</text>
                <text class="odds-value">{{item.draw}}</text>
              </view>
              <view class="odds-item">
                <text class="odds-label">{{item.awayTeamAbbName}}胜</text>
                <text class="odds-value">{{item.awayWin}}</text>
              </view>
            </view>

            <!-- 队伍标签 -->
            <view class="tags-section" wx:if="{{item.homeTags || item.awayTags}}">
              <view class="team-tags" wx:if="{{item.homeTags}}">
                <text class="tags-label">主队:</text>
                <view class="tags">
                  <text class="tag" wx:for="{{item.homeTags.split(',')}}" wx:key="*this">{{item}}</text>
                </view>
              </view>
              <view class="team-tags" wx:if="{{item.awayTags}}">
                <text class="tags-label">客队:</text>
                <view class="tags">
                  <text class="tag" wx:for="{{item.awayTags.split(',')}}" wx:key="*this">{{item}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 主要赛事 -->
      <view class="topic-section" wx:if="{{majorEvents.length > 0}}">
        <text class="section-title">⭐ 主要赛事</text>
        <view class="items-container">
          <view class="event-item" wx:for="{{majorEvents}}" wx:key="id">
            <image class="event-image" src="{{item.imageUrl}}" mode="aspectFill" />
            <view class="event-overlay">
              <text class="event-title">{{item.topicName}}</text>
              <text class="event-desc">{{item.topicDesc}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{hotMatches.length === 0 && majorEvents.length === 0}}">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无专题内容</text>
        <text class="empty-tip">敬请期待</text>
      </view>

      <!-- 底部占位 -->
      <view class="bottom-placeholder"></view>
    </scroll-view>
  </view>
</view>
