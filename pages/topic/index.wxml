<!-- pages/topic/index.wxml -->
<view class="topic-page">
  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-wrapper" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 主内容 -->
  <view class="main-content" wx:else>
    <!-- 页面标题 -->
    <view class="page-header">
      <text class="page-title">📌 专题</text>
    </view>

    <!-- 内容区域 -->
    <scroll-view class="topic-content" scroll-y enable-back-to-top="true">
      <!-- 热门赛事轮播 -->
      <view class="swiper-section" wx:if="{{majorEvents.length > 0}}">
        <swiper class="event-swiper" indicator-dots autoplay circular>
          <swiper-item wx:for="{{majorEvents}}" wx:key="id">
            <view class="swiper-item-wrapper">
              <image class="swiper-image" src="{{item.carouselImageUrl}}" mode="scaleToFill" />
            </view>
          </swiper-item>
        </swiper>
      </view>

      <!-- 今日热门比赛 -->
      <view class="topic-section" wx:if="{{hotMatches.length > 0}}">
        <view class="section-header">
          <text class="section-title">🔥 今日热门比赛</text>
          <text class="section-count">共 {{hotMatches.length}} 场</text>
        </view>
        <view class="items-container">
          <view class="match-item" wx:for="{{hotMatches}}" wx:key="matchId">
            <!-- 比赛头部 -->
            <view class="match-top">
              <view class="league-badge" style="background-color: #{{item.backColor}}">
                <text class="league-text">{{item.leagueAbbName}}</text>
              </view>
              <text class="match-time">{{item.matchTime}}</text>
              <text class="match-status">{{item.matchStatusName}}</text>
            </view>

            <!-- 对阵信息 -->
            <view class="match-vs-section">
              <view class="team-info home">
                <text class="team-name">{{item.homeTeamAbbName}}</text>
                <view class="team-rank">排名 {{item.homeTeamRank}}</view>
              </view>
              <view class="vs-middle">
                <text class="vs">VS</text>
              </view>
              <view class="team-info away">
                <text class="team-name">{{item.awayTeamAbbName}}</text>
                <view class="team-rank">排名 {{item.awayTeamRank}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 热门专题 -->
      <view class="topic-section" wx:if="{{hotTopics.length > 0}}">
        <text class="section-title">🔥 热门专题</text>
        <view class="events-grid">
          <view class="event-card" wx:for="{{hotTopics}}" wx:key="id" bindtap="onEventCardTap" data-url="{{item.imageUrl}}">
            <view class="event-card-image">
              <image src="{{item.imageUrl}}" mode="aspectFill" />
              <view class="event-card-badge hot-badge">进行中</view>
            </view>
            <view class="event-card-info">
              <text class="event-card-title">{{item.topicName}}</text>
              <text class="event-card-desc">{{item.topicDesc}}</text>
              <text class="event-card-date" wx:if="{{item.startDate && item.endDate}}">{{item.startDate}} - {{item.endDate}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 精选专题 -->
      <view class="topic-section" wx:if="{{selectTopics.length > 0}}">
        <text class="section-title">⭐ 精选专题</text>
        <view class="events-grid">
          <view class="event-card" wx:for="{{selectTopics}}" wx:key="id" bindtap="onEventCardTap" data-url="{{item.imageUrl}}">
            <view class="event-card-image">
              <image src="{{item.imageUrl}}" mode="aspectFill" />
              <view class="event-card-badge">敬请期待</view>
            </view>
            <view class="event-card-info">
              <text class="event-card-title">{{item.topicName}}</text>
              <text class="event-card-desc">{{item.topicDesc}}</text>
              <text class="event-card-date" wx:if="{{item.startDate && item.endDate}}">{{item.startDate}} - {{item.endDate}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{hotMatches.length === 0 && hotTopics.length === 0 && selectTopics.length === 0}}">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无专题内容</text>
        <text class="empty-tip">敬请期待</text>
      </view>

      <!-- 底部占位 -->
      <view class="bottom-placeholder"></view>
    </scroll-view>
  </view>
</view>
