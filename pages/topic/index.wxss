/* pages/topic/index.wxss */

.topic-page {
  height: 100vh;
  background: linear-gradient(180deg, #f0f4f8 0%, #e8eef3 100%);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 模拟选号按钮 - 可拖动区域 */
.calculator-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  pointer-events: none;
}

.calculator-btn {
  width: 180rpx;
  height: 72rpx;
  padding: 0 28rpx;
  background: linear-gradient(135deg, #ff9a56 0%, #ff6a88 100%);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 86, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  pointer-events: auto;
}

.calculator-btn:active {
  opacity: 0.9;
}

.calculator-icon {
  font-size: 28rpx;
}

.calculator-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* ---- 加载 / 错误 ---- */
.loading-wrapper,
.error-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--border-color, #f0f0f0);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

.error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  text-align: center;
  padding: 0 40rpx;
  margin-bottom: 24rpx;
}

.retry-btn {
  padding: 14rpx 48rpx;
  background: #667eea;
  color: #fff;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.retry-btn:active {
  opacity: 0.85;
}

/* ---- 滚动区域 ---- */
.topic-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ---- 轮播 ---- */
.swiper-section {
  margin-bottom: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.event-swiper {
  height: 420rpx;
}

.swiper-item {
  position: relative;
  width: 100%;
  height: 420rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
}

.swiper-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
}

.swiper-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1.3;
}

.swiper-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
  line-height: 1.3;
}

/* ---- 区块 ---- */
.section {
  margin-bottom: 32rpx;
}

.section-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-bar-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  margin-right: 12rpx;
}

.section-bar-dot.hot {
  background: linear-gradient(180deg, #ff4d4f, #faad14);
}

.section-bar-dot.upcoming {
  background: linear-gradient(180deg, #1890ff, #36cfc9);
}

.section-bar-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 700;
}

.section-bar-extra {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

.section-bar-badge {
  margin-left: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
  color: #fff;
  background: #ff4d4f;
}

/* 热门专区 - 水平卡片布局 */
.hot-zones-row {
  display: flex;
  gap: 20rpx;
}

.hot-zone-card {
  flex: 1;
  background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #ffe0e0;
  min-height: 280rpx;
}

.hot-zone-card.upcoming {
  background: linear-gradient(135deg, #f0f7ff 0%, #fff 100%);
  border-color: #d6e4ff;
}

.hot-zone-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.hot-zone-icon {
  font-size: 32rpx;
}

.hot-zone-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 700;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-zone-badge {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 9999rpx;
  color: #fff;
  background: #ff4d4f;
}

.hot-zone-badge.live {
  background: linear-gradient(135deg, #ff4d4f, #ff6a88);
}

/* 欧冠比赛列表 */
.hot-zone-matches {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hot-zone-matches.empty {
  justify-content: center;
  align-items: center;
  flex: 1;
}

.zone-empty-text {
  font-size: 22rpx;
  color: #999;
}

.zone-match-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #ffe0e0;
}

.zone-match-time {
  font-size: 20rpx;
  color: #1890ff;
  font-weight: 600;
  flex-shrink: 0;
}

.zone-match-teams {
  flex: 1;
  font-size: 22rpx;
  color: #333;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.zone-match-score {
  font-size: 22rpx;
  color: #ff4d4f;
  font-weight: 700;
  background: #fff0f0;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

/* 世界杯信息 */
.hot-zone-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.zone-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
}

.zone-date {
  font-size: 20rpx;
  color: #1890ff;
  font-weight: 500;
}

/* ---- 比赛卡片 ---- */
.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-card-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.match-card {
  padding: 28rpx;
}

.match-card:active {
  opacity: 0.9;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.match-num {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

.league-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.match-time {
  font-size: 22rpx;
  color: #1890ff;
  font-weight: 600;
}

.teams-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
}

.team-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.team-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 700;
  text-align: center;
}

.team-rank {
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
}

.vs {
  font-size: 24rpx;
  color: #ccc;
  font-weight: 700;
  padding: 0 24rpx;
}

/* 赔率行 */
.odds-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

/* 按钮间距 */
.action-gap {
  width: 16rpx;
}

.odds-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.odds-label {
  font-size: 22rpx;
  color: #999;
}

.odds-num {
  font-size: 28rpx;
  color: #333;
  font-weight: 700;
}

/* 数据分析按钮 */
.odds-cell.action-cell.data-btn {
  background: linear-gradient(135deg, #36cfc9 0%, #1890ff 100%);
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
}

.odds-cell.action-cell.data-btn .action-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.odds-cell.action-cell.data-btn .action-tag {
  font-size: 24rpx;
}

.odds-cell.action-cell.data-btn .action-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

/* AI智能分析按钮 */
.odds-cell.action-cell.ai-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
}

.odds-cell.action-cell.ai-btn .action-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.odds-cell.action-cell.ai-btn .ai-btn-wrapper {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.odds-cell.action-cell.ai-btn .lock-icon {
  font-size: 18rpx;
}

.odds-cell.action-cell.ai-btn .action-tag {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.odds-cell.action-cell.ai-btn .action-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ---- 专题卡片 ---- */
.topic-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.topic-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.topic-card:active {
  opacity: 0.9;
}

.topic-cover {
  position: relative;
  width: 100%;
  height: 180rpx;
}

.topic-cover-img {
  width: 100%;
  height: 100%;
}

.topic-cover-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.45);
}

.topic-cover-tag.hot {
  background: #ff4d4f;
}

.topic-body {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.topic-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 700;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-desc {
  font-size: 20rpx;
  color: #999;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-date {
  font-size: 20rpx;
  color: #1890ff;
  font-weight: 500;
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #999;
}

/* ---- 底部安全区 ---- */
.bottom-space {
  height: 120rpx;
}
