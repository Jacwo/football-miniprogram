/* pages/topic/index.wxss */
@import '../../components/match-card/index.wxss';

.topic-page {
  height: 100vh;
  background: linear-gradient(180deg, #f0f4f8 0%, #e8eef3 100%);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ---- 加载 / 错误 ---- */
.loading-wrapper,
.error-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--border-color, #f0f0f0);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

.error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  text-align: center;
  padding: 0 40rpx;
  margin-bottom: 24rpx;
}

.retry-btn {
  padding: 14rpx 48rpx;
  background: #667eea;
  color: #fff;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.retry-btn:active {
  opacity: 0.85;
}

/* ---- 滚动区域 ---- */
.topic-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ---- 轮播 ---- */
.swiper-section {
  margin-bottom: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.event-swiper {
  height: 420rpx;
}

.swiper-item {
  position: relative;
  width: 100%;
  height: 420rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
}

.swiper-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
}

.swiper-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1.3;
}

.swiper-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
  line-height: 1.3;
}

/* ---- 区块 ---- */
.section {
  margin-bottom: 32rpx;
}

.section-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-bar-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  margin-right: 12rpx;
}

.section-bar-dot.hot {
  background: linear-gradient(180deg, #ff4d4f, #faad14);
}

.section-bar-dot.upcoming {
  background: linear-gradient(180deg, #1890ff, #36cfc9);
}

.section-bar-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 700;
}

.section-bar-extra {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

.section-bar-badge {
  margin-left: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
  color: #fff;
  background: #ff4d4f;
}

/* 热门专题 - 全宽卡片列表 */
.event-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hot-zone-card.full-width {
  flex: none;
  width: 100%;
  box-sizing: border-box;
}

/* 热门专区 - 水平卡片布局 */
.hot-zones-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.hot-zone-card {
  flex: 1;
  background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #ffe0e0;
  min-height: 280rpx;
}

.hot-zone-card.upcoming {
  background: linear-gradient(135deg, #f0f7ff 0%, #fff 100%);
  border-color: #d6e4ff;
}

/* 世界杯封面图 */
.hot-zone-cover {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 16rpx 0;
}

.hot-zone-img {
  width: 100%;
  height: 100%;
}

.hot-zone-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.hot-zone-icon {
  font-size: 32rpx;
}

.hot-zone-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 700;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-zone-badge {
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 9999rpx;
  color: #fff;
  background: #ff4d4f;
}

.hot-zone-badge.live {
  background: linear-gradient(135deg, #ff4d4f, #ff6a88);
}

/* 欧冠比赛列表 */
.hot-zone-matches {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hot-zone-matches.empty {
  justify-content: center;
  align-items: center;
  flex: 1;
}

.zone-empty-text {
  font-size: 22rpx;
  color: #999;
}

.zone-match-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #ffe0e0;
}

.zone-match-time {
  font-size: 20rpx;
  color: #1890ff;
  font-weight: 600;
  flex-shrink: 0;
}

.zone-match-teams {
  flex: 1;
  font-size: 22rpx;
  color: #333;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.zone-match-score {
  font-size: 22rpx;
  color: #ff4d4f;
  font-weight: 700;
  background: #fff0f0;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

/* 世界杯信息 */
.hot-zone-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.zone-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.zone-date {
  font-size: 20rpx;
  color: #1890ff;
  font-weight: 600;
  flex-shrink: 0;
}

/* ---- 比赛卡片 ---- */
.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* VIP横幅内联样式 */
.section-bar-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.vip-banner-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 30rpx;
  max-width: 50%;
}

.vip-banner-inline:active {
  opacity: 0.9;
}

.vip-banner-inline-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.vip-banner-inline-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* VIP风格比赛列表 */
.match-list.vip-style {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-radius: 16rpx;
  padding: 16rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.15);
}

/* ---- 专题卡片 ---- */
.topic-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.topic-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.topic-card:active {
  opacity: 0.9;
}

.topic-cover {
  position: relative;
  width: 100%;
  height: 180rpx;
}

.topic-cover-img {
  width: 100%;
  height: 100%;
}

.topic-cover-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.45);
}

.topic-cover-tag.hot {
  background: #ff4d4f;
}

.topic-cover-tag.finished {
  background: #999;
}

.topic-body {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.topic-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 700;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-desc {
  font-size: 20rpx;
  color: #999;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-date {
  font-size: 20rpx;
  color: #1890ff;
  font-weight: 500;
}

/* 名称和日期同行 */
.topic-title-row {
  white-space: nowrap;
  overflow: hidden;
}

.topic-name-inline {
  font-size: 24rpx;
  color: #333;
  font-weight: 700;
}

.topic-date-inline {
  font-size: 20rpx;
  color: #1890ff;
  font-weight: 500;
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #999;
}

/* ---- 底部安全区 ---- */
.bottom-space {
  height: 120rpx;
}
