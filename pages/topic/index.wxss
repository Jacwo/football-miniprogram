/* pages/topic/index.wxss */

.topic-page {
  height: 100vh;
  background: var(--bg-color, #f5f5f5);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---- 加载 / 错误 ---- */
.loading-wrapper,
.error-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--border-color, #f0f0f0);
  border-top-color: var(--primary-color, #1890ff);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: var(--font-sm, 24rpx);
  color: var(--text-disabled, #999);
}

.error-text {
  font-size: var(--font-sm, 24rpx);
  color: var(--error-color, #ff4d4f);
  text-align: center;
  padding: 0 40rpx;
  margin-bottom: 24rpx;
}

.retry-btn {
  padding: 14rpx 48rpx;
  background: var(--primary-color, #1890ff);
  color: #fff;
  border-radius: var(--radius-lg, 16rpx);
  font-size: var(--font-sm, 24rpx);
  font-weight: 500;
}

.retry-btn:active {
  opacity: 0.85;
}

/* ---- 滚动区域 ---- */
.topic-scroll {
  flex: 1;
  padding: var(--spacing-lg, 24rpx);
}

/* ---- 轮播 ---- */
.swiper-section {
  margin-bottom: var(--spacing-xl, 32rpx);
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
}

.event-swiper {
  height: 420rpx;
}

.swiper-item {
  position: relative;
  width: 100%;
  height: 420rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
}

.swiper-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
}

.swiper-title {
  font-size: var(--font-lg, 32rpx);
  color: #fff;
  font-weight: 700;
  line-height: 1.3;
}

.swiper-desc {
  font-size: var(--font-xs, 22rpx);
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
  line-height: 1.3;
}

/* ---- 区块 ---- */
.section {
  margin-bottom: var(--spacing-xl, 32rpx);
}

.section-bar {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md, 16rpx);
  padding: 0 4rpx;
}

.section-bar-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  margin-right: 12rpx;
}

.section-bar-dot.hot {
  background: linear-gradient(180deg, #ff4d4f, #faad14);
}

.section-bar-dot.upcoming {
  background: linear-gradient(180deg, #1890ff, #36cfc9);
}

.section-bar-title {
  font-size: var(--font-md, 28rpx);
  color: var(--text-color, #333);
  font-weight: 700;
}

.section-bar-extra {
  font-size: var(--font-xs, 22rpx);
  color: var(--text-disabled, #999);
  margin-left: auto;
}

.section-bar-badge {
  margin-left: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-round, 9999rpx);
  color: #fff;
  background: #ff4d4f;
}

/* ---- 比赛卡片 ---- */
.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-card {
  background: #fff;
  border-radius: var(--radius-lg, 16rpx);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(0, 0, 0, 0.03));
}

.match-card:active {
  opacity: 0.9;
}

.match-league {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color, #f0f0f0);
}

.league-tag {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm, 8rpx);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.match-time {
  font-size: var(--font-xs, 22rpx);
  color: var(--primary-color, #1890ff);
  font-weight: 600;
}

.match-status {
  font-size: 20rpx;
  color: var(--text-disabled, #999);
  margin-left: auto;
}

.match-teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 22rpx;
}

.team-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.team-name {
  font-size: var(--font-md, 28rpx);
  color: var(--text-color, #333);
  font-weight: 700;
  text-align: center;
}

.team-rank {
  font-size: 20rpx;
  color: var(--text-disabled, #999);
  background: var(--bg-color, #f5f5f5);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-round, 9999rpx);
}

.vs-text {
  font-size: var(--font-xs, 22rpx);
  color: var(--border-color, #f0f0f0);
  font-weight: 700;
  padding: 0 16rpx;
}

/* ---- 专题卡片 ---- */
.topic-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-sm, 12rpx);
}

.topic-card {
  background: #fff;
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(0, 0, 0, 0.03));
}

.topic-card:active {
  opacity: 0.9;
}

.topic-cover {
  position: relative;
  width: 100%;
  height: 180rpx;
}

.topic-cover-img {
  width: 100%;
  height: 100%;
}

.topic-cover-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-round, 9999rpx);
  background: rgba(0, 0, 0, 0.45);
}

.topic-cover-tag.hot {
  background: #ff4d4f;
}

.topic-body {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.topic-name {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-color, #333);
  font-weight: 700;
  line-height: var(--line-height-tight, 1.3);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-desc {
  font-size: 20rpx;
  color: var(--text-disabled, #999);
  line-height: var(--line-height-tight, 1.3);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-date {
  font-size: 20rpx;
  color: var(--primary-color, #1890ff);
  font-weight: 500;
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: var(--font-md, 28rpx);
  color: var(--text-secondary, #666);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: var(--font-sm, 24rpx);
  color: var(--text-disabled, #999);
}

/* ---- 底部安全区 ---- */
.bottom-space {
  height: 120rpx;
}
