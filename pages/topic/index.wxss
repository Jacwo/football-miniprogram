/* pages/topic/index.wxss */
.topic-page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fb 0%, #f5f7fa 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.loading-wrapper, .error-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text, .error-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.retry-btn {
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  background: #667eea;
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 页面头部 */
.page-header {
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 32rpx 24rpx;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.page-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.page-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 400;
}

/* 内容区域 */
.topic-content {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 12rpx 24rpx 12rpx;
}

/* 专题分组 */
.topic-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  padding: 0 12rpx;
}

.items-container {
  gap: 12rpx;
  display: flex;
  flex-direction: column;
}

/* 热门比赛卡片 */
.match-item {
  background: linear-gradient(135deg, #fff 0%, #f8f9fb 100%);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.match-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* 比赛头部 */
.match-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(90deg, rgba(102, 126, 234, 0.05) 0%, transparent 100%);
  border-bottom: 1rpx solid #f0f0f0;
}

.league-badge {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
}

.league-text {
  color: #fff;
}

.match-time {
  font-size: 18rpx;
  color: #667eea;
  font-weight: 600;
}

.match-status {
  font-size: 16rpx;
  color: #999;
  margin-left: auto;
}

/* 对阵信息 */
.match-vs-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  gap: 12rpx;
}

.team-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.team-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 700;
  line-height: 1.2;
}

.team-rank {
  font-size: 16rpx;
  color: #999;
  background: #f0f0f0;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.trend {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 16rpx;
  font-weight: 600;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.trend.down {
  background: rgba(255, 59, 48, 0.1);
  color: #ff3b30;
}

.trend-icon {
  font-size: 18rpx;
}

.vs-middle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
}

.vs {
  font-size: 18rpx;
  color: #ccc;
  font-weight: 600;
}

/* 赔率信息 */
.odds-section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.04) 100%);
  border-bottom: 1rpx solid #f0f0f0;
}

.odds-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e8e8e8;
}

.odds-label {
  font-size: 16rpx;
  color: #999;
  margin-bottom: 4rpx;
  text-align: center;
  line-height: 1.2;
}

.odds-value {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 700;
}

/* 队伍标签 */
.tags-section {
  padding: 16rpx;
  gap: 12rpx;
  display: flex;
  flex-direction: column;
}

.team-tags {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.tags-label {
  font-size: 18rpx;
  color: #666;
  font-weight: 600;
  white-space: nowrap;
  min-width: 60rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}

.tag {
  font-size: 14rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

/* 赛事卡片 */
.event-item {
  position: relative;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  transition: all 0.3s ease;
}

.event-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.event-image {
  width: 100%;
  height: 100%;
  display: block;
}

.event-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.6) 100%);
  color: #fff;
  gap: 8rpx;
  padding: 20rpx;
  text-align: center;
}

.event-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  display: block;
  letter-spacing: 1rpx;
}

.event-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.bottom-placeholder {
  height: 120rpx;
}
